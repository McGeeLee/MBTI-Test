{
  "name": "mbti-test-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mbti/web -- --host 127.0.0.1",
    "build": "npm run build --workspace @mbti/web",
    "check:data": "python3 tools/sync_mobile_data.py --check",
    "sync:data": "python3 tools/sync_mobile_data.py",
    "verify": "npm run check:data && npm run verify --workspace @mbti/web"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "vite": "8.2.0",
    "brace-expansion@1.1.12": "1.1.18",
    "flatted@3.3.3": "3.4.4",
    "minimatch@3.1.2": "3.1.5",
    "picomatch@2.3.1": "2.3.2",
    "picomatch@4.0.3": "4.0.5"
  }
}
